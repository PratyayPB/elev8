# Database
DATABASE_URL="postgresql://user:password@localhost:5432/elev8?schema=public"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI Multi-Provider Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash"

GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"

OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="minimax/minimax-m3,minimax/minimax-m2.7,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,tencent/hy3"

# LLM Fallback Policy
LLM_PRIMARY_PROVIDER="gemini"
LLM_FALLBACK_ORDER="gemini,groq,openrouter"


# Trigger.dev
TRIGGER_SECRET_KEY="tr_dev_..."

# Storage (Vercel Blob / UploadThing)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
UPLOADTHING_TOKEN="ut_..."
WEBHOOK_SECRET="your_clerk_webhook_secret_here"
