// Prisma schema file for Elev8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum CurrentStatus {
  STUDENT
  GRADUATE
  WORKING_PROFESSIONAL
  CAREER_SWITCHER
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CareerLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoadmapStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ResumeStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum InterviewStatus {
  GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewCategory {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  ROLE_SPECIFIC
  GENERAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  ROADMAP
  CAREER_GUIDANCE
  INTERVIEW
  RESUME_ANALYSIS
  EXPORT
}


// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?

  profile           UserProfile?
  careerAssessments CareerAssessment[]
  careerGuidances   CareerGuidance[]
  roadmaps          Roadmap[]
  resumes           Resume[]
  interviews        Interview[]
  progress          Progress?
  notifications     Notification[]
  jobs              Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  fullName        String?
  profilePicture  String?   // Read-only URL from Clerk
  email           String?   // Read-only email synced from Clerk
  country         String?   // Free-text input
  timezone        String?   // Free-text input

  // Academic Information
  currentStatus   CurrentStatus?
  degree          String?
  major           String?
  institution     String?
  graduationYear  Int?

  // Professional Information
  currentRole       String?
  yearsOfExperience Int?
  industry          String?
  employmentStatus  String?

  // Career Interests, Skills, Goals
  careerInterests   String[]
  skills            Json?      // JSON object storing categorized arrays: { languages: [], frameworks: [], databases: [], cloud: [], tools: [], softSkills: [] }
  careerGoals       String[]

  // Preferences
  learningStyle     String?
  difficulty        String?
  weeklyHours       Int?

  // Onboarding tracking
  onboardingStatus    OnboardingStatus  @default(NOT_STARTED)
  onboardingStep      Int               @default(0)
  profileCompletion   Int               @default(0)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("user_profiles")
}

model CareerAssessment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole     String?
  targetIndustry String?
  currentLevel   CareerLevel?
  skills         String[]
  interests      String[]
  goals          String[]
  notes          String?

  careerGuidances CareerGuidance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("career_assessments")
}

model CareerGuidance {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   CareerAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  title           String
  status          RoadmapStatus? @default(NOT_STARTED)
  contentUrl      String?        // Reference to large report artifact stored in Blob Storage
  careerMatch     String?
  marketReadiness Int?
  salaryMin       Int?
  salaryMax       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assessmentId])
  @@index([createdAt])
  @@map("career_guidances")
}

model Roadmap {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  targetCareer      String
  targetRole        String?
  experienceLevel   CareerLevel?
  estimatedDuration String?
  status            RoadmapStatus @default(NOT_STARTED)
  contentUrl        String?       // Reference to large AI-generated JSON roadmap artifact in Blob Storage
  blobUrl           String?
  version           String        @default("1.0.0")

  milestones RoadmapMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("roadmaps")
}

model Job {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         JobType
  status       JobStatus @default(QUEUED)
  progress     Int       @default(0)
  step         String?
  triggerRunId String?
  artifactId   String?
  artifactType String?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}


model RoadmapMilestone {
  id        String   @id @default(cuid())
  roadmapId String
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  order          Int
  status         MilestoneStatus @default(NOT_STARTED)
  estimatedHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roadmapId])
  @@index([roadmapId, order])
  @@map("roadmap_milestones")
}

model Resume {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role               String
  experienceLevel    String
  overallScore       Int?
  atsScore           Int?
  artifactBlobUrl    String?      // Reference to ResumeArtifact JSON in Blob Storage
  originalPdfBlobUrl String?      // Reference to original uploaded PDF in Blob Storage
  status             ResumeStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("resumes")
}


model Interview {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  role              String
  difficulty        String
  experienceLevel   String
  interviewType     String?
  status            InterviewStatus   @default(GENERATING)
  blobUrl           String?
  questionCount     Int               @default(5)
  estimatedDuration String?

  overallScore      Int?
  durationSeconds   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("interviews")
}

model Progress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedMilestones Int  @default(0)
  totalMilestones     Int  @default(0)
  interviewReadiness  Int?
  resumeReadiness     Int?
  careerReadiness     Int?
  overallProgress     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("progress")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String?
  status NotificationStatus @default(UNREAD)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}
